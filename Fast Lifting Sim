-- BOSS LOGIC
local function isPartAlive(rootPart)
    if not rootPart or not rootPart.Parent then return false end
    local humanoid = rootPart.Parent:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end

local function findBossNPC(bossFolder)
    if not bossFolder or not bossFolder.Parent then return nil end
    for _, child in ipairs(bossFolder:GetChildren()) do
        if child:IsA("Model") then
            local humanoid = child:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local rootPart = child:FindFirstChild("HumanoidRootPart") or child.PrimaryPart
                if rootPart then return rootPart end
            end
        end
    end
    return nil
end

local function findAliveBossTarget()
    if currentTargetPart and isPartAlive(currentTargetPart) then
        return currentTargetPart
    end

    local folder = workspace:FindFirstChild("BossesAreas")
    if not folder then 
        currentTargetPart = nil
        return nil 
    end

    for _, bossName in ipairs(allowedBosses) do
        if config.bossToggles[bossName] ~= false then
            local bossFolder = folder:FindFirstChild(bossName)
            if bossFolder then
                local targetPart = findBossNPC(bossFolder)
                if targetPart then 
                    currentTargetPart = targetPart
                    return targetPart 
                end
            end
        end
    end
    
    currentTargetPart = nil
    return nil
end

local function isSlot3Equipped()
    local playerGui = player:FindFirstChild("PlayerGui")
    if playerGui and playerGui:FindFirstChild("Backpack") and playerGui.Backpack:FindFirstChild("Hotbar") then
        local slot3 = playerGui.Backpack.Hotbar:FindFirstChild("3")
        if slot3 and slot3:FindFirstChild("Equipped") then return slot3.Equipped.Visible end
    end
    if character then
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Tool") or child.Name:lower():find("stomp") then return true end
        end
    end
    return false
end

local function ensureSlot3Equipped()
    if not isSlot3Equipped() then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
    end
end

local function executeAutoAttack()
    if not character then return end
    ensureSlot3Equipped()
    local currentTool = character:FindFirstChildOfClass("Tool")
    if currentTool then
        currentTool:Activate()
    else
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end
end

-- CRATE LOGIC
local function isValidSpawnedCrate(obj)
    if not obj or not obj.Parent or obj.Name ~= "Crate" then return false end
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end

    local hasPrize = obj:FindFirstChild("Prize") or obj:FindFirstChild("Script")
    local parentName = string.lower(obj.Parent.Name)
    local isMapDecor = parentName:find("shop") or parentName:find("map") or parentName:find("building")

    return (hasPrize ~= nil) and not isMapDecor
end

local function getPhysicalPartFromCrate(crateObj)
    if not crateObj then return nil end
    if crateObj:IsA("BasePart") then return crateObj end
    return crateObj:FindFirstChildWhichIsA("BasePart", true)
end

local function farmCrate(crateObj)
    if isFarmingCrate or not crateObj or not crateObj.Parent or processedCrates[crateObj] then return end

    local myRoot = character and character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    -- Pause loops and mark crate
    isFarmingCrate = true
    processedCrates[crateObj] = true

    -- 1. Save original position before doing anything
    local savedCFrame = myRoot.CFrame
    local targetPart = getPhysicalPartFromCrate(crateObj)

    if targetPart then
        -- Teleport to crate
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.CFrame = targetPart.CFrame * CRATE_OFFSET

        -- Fire touch event
        if firetouchinterest then
            pcall(function()
                firetouchinterest(myRoot, targetPart, 0)
                task.wait(0.05)
                firetouchinterest(myRoot, targetPart, 1)
            end)
        end

        -- 2. PAUSE LOOP: Stay locked on crate until it despawns/gets claimed
        while crateObj and crateObj.Parent and targetPart and targetPart.Parent do
            if character and character:FindFirstChild("HumanoidRootPart") then
                character.HumanoidRootPart.CFrame = targetPart.CFrame * CRATE_OFFSET
            end
            task.wait(0.1)
        end
    end

    -- 3. UNPAUSE & RETURN: Crate is gone, instantly return to saved location
    myRoot = character and character:FindFirstChild("HumanoidRootPart")
    if myRoot and savedCFrame then
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.CFrame = savedCFrame
    end

    task.wait(0.1)
    isFarmingCrate = false
end

local function findAvailableCrate()
    for _, obj in ipairs(workspace:GetChildren()) do
        if not processedCrates[obj] and isValidSpawnedCrate(obj) then
            if getPhysicalPartFromCrate(obj) then
                return obj
            end
        end
    end
    return nil
end

-- MAIN EXECUTION LOOP
task.spawn(function()
    while true do
        if character and character.Parent then
            local myRoot = character:FindFirstChild("HumanoidRootPart")

            -- Priority 1: Check and farm crates
            if config.crateTpEnabled and not isFarmingCrate then
                local crateToFarm = findAvailableCrate()
                if crateToFarm then
                    farmCrate(crateToFarm)
                end
            end

            -- Priority 2: Auto Boss TP (Completely blocked while crate farming is active)
            if config.autoTpEnabled and not isFarmingCrate then
                local targetPart = findAliveBossTarget()
                if targetPart and myRoot then
                    myRoot.CFrame = targetPart.CFrame * SAFE_OFFSET
                    local distance = (myRoot.Position - targetPart.Position).Magnitude
                    if distance <= 25 then
                        executeAutoAttack()
                    end
                end
            end
        end
        task.wait(loopDelay)
    end
end)

