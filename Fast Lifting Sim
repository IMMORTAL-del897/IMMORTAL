-- Helper function to get current time in 12-hour format with AM/PM
local function get12HourTime()
    return os.date("%I:%M:%S %p")
end

local function parseFormattedValue(val)
    if not val or val == "N/A" then return nil end
    if type(val) == "number" then return val end
    local str = tostring(val):gsub(",", ""):gsub("%s+", ""):upper()
    local numStr = str:match("[%d%.]+")
    if not numStr then return nil end
    local num = tonumber(numStr)
    if not num then return nil end
    if str:find("B") then num = num * 1000000000
    elseif str:find("M") then num = num * 1000000
    elseif str:find("K") then num = num * 1000 end
    return num
end

local function getCurrentGemsNumber()
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local gemsObj = leaderstats:FindFirstChild("Gems") or leaderstats:FindFirstChild("Gem")
        if gemsObj and gemsObj:IsA("ValueBase") then return gemsObj.Value end
    end
    local directGems = player:FindFirstChild("Gems") or player:FindFirstChild("Gem")
    if directGems and directGems:IsA("ValueBase") then return directGems.Value end

    local playerGui = player:FindFirstChild("PlayerGui")
    if playerGui then
        local mainGui = playerGui:FindFirstChild("Main")
        if mainGui and mainGui:FindFirstChild("Frame") and mainGui.Frame:FindFirstChild("GemsFrame") then
            local gemsFrame = mainGui.Frame.GemsFrame
            local textObj = gemsFrame:IsA("TextLabel") and gemsFrame or gemsFrame:FindFirstChildOfClass("TextLabel")
            if textObj and textObj.Text ~= "" then return parseFormattedValue(textObj.Text) end
        end
    end
    return nil
end

local function getCurrentGoldNumber()
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local goldObj = leaderstats:FindFirstChild("Gold")
        if goldObj and goldObj:IsA("ValueBase") then return goldObj.Value end
    end
    local directGold = player:FindFirstChild("Gold")
    if directGold and directGold:IsA("ValueBase") then return directGold.Value end

    local playerGui = player:FindFirstChild("PlayerGui")
    if playerGui then
        local mainGui = playerGui:FindFirstChild("Main")
        if mainGui and mainGui:FindFirstChild("Frame") and mainGui.Frame:FindFirstChild("GoldFrame") then
            local goldFrame = mainGui.Frame.GoldFrame
            local textObj = goldFrame:IsA("TextLabel") and goldFrame or goldFrame:FindFirstChildOfClass("TextLabel")
            if textObj and textObj.Text ~= "" then return parseFormattedValue(textObj.Text) end
        end
    end
    return nil
end

-- CONFIG SYSTEM (SAVE / LOAD)
local function saveConfig()
    if writefile then
        pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(config)) end)
    end
end

local function loadConfig()
    if readfile and isfile and isfile(CONFIG_FILE) then
        local success, rawData = pcall(function() return readfile(CONFIG_FILE) end)
        if success and rawData then
            local decSuccess, result = pcall(function() return HttpService:JSONDecode(rawData) end)
            if decSuccess and type(result) == "table" then
                if result.webhookUrl ~= nil then config.webhookUrl = result.webhookUrl end
                if result.bossRoleId ~= nil then config.bossRoleId = result.bossRoleId end
                if result.merchantRoleId ~= nil then config.merchantRoleId = result.merchantRoleId end
                if result.autoTpEnabled ~= nil then config.autoTpEnabled = result.autoTpEnabled end
                if result.bossToggles ~= nil then
                    for k, v in pairs(result.bossToggles) do config.bossToggles[k] = v end
                end
            end
        end
    end
end

