-- SAVE / LOAD SYSTEM
local function saveConfig()
    if writefile then
        pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(config)) end)
    end
end

local function loadConfig()
    if readfile and isfile and isfile(CONFIG_FILE) then
        local success, rawData = pcall(function() return readfile(CONFIG_FILE) end)
        if success and rawData then
            local decSuccess, result = pcall(function() return HttpService:JSONDecode(rawData) end)
            if decSuccess and type(result) == "table" then
                if result.autoTpEnabled ~= nil then config.autoTpEnabled = result.autoTpEnabled end
                if result.crateTpEnabled ~= nil then config.crateTpEnabled = result.crateTpEnabled end
                if result.bossToggles ~= nil then
                    for k, v in pairs(result.bossToggles) do config.bossToggles[k] = v end
                end
            end
        end
    end
end

