local function sendMerchantWebhookNotification()
    if not config.webhookUrl or config.webhookUrl == "" then
        warn("[Merchant Check] Cannot send webhook: Webhook URL is empty!")
        return
    end

    local pingText = (config.merchantRoleId and config.merchantRoleId ~= "") and ("<@&" .. config.merchantRoleId .. ">") or "@here"

    local embedData = {
        ["title"] = "🛒 Merchant Spawned!",
        ["description"] = "A Traveling Merchant (Dummy) has spawned in the server!",
        ["color"] = 16753920,
        ["fields"] = {
            { ["name"] = "👤 Player In Server", ["value"] = player.Name, ["inline"] = true },
            { ["name"] = "🌐 Server JobID", ["value"] = "```" .. JOB_ID .. "```", ["inline"] = false }
        },
        ["footer"] = { ["text"] = "Merchant Checker • " .. get12HourTime() }
    }

    local requestBody = HttpService:JSONEncode({
        ["username"] = "Merchant Checker",
        ["content"] = pingText .. " 🛒 **Merchant Spawned!**",
        ["embeds"] = { embedData }
    })

    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
    if httpRequest then
        local success, err = pcall(function()
            httpRequest({
                Url = config.webhookUrl,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = requestBody
            })
        end)
        if success then
            print("[Merchant Check] Webhook successfully sent to Discord!")
        else
            warn("[Merchant Check] Webhook failed to send:", err)
        end
    else
        warn("[Merchant Check] No HTTP request function found in executor!")
    end
end

-- SEPARATE WEBHOOK: BOSS KILLED
local function sendBossWebhookNotification(bossName, customMessage)
    if not config.webhookUrl or config.webhookUrl == "" then return end

    local currentGoldNum = getCurrentGoldNumber()
    local currentGemsNum = getCurrentGemsNumber()

    if previousGold == nil and currentGoldNum then previousGold = currentGoldNum end
    if previousGems == nil and currentGemsNum then previousGems = currentGemsNum end

    if not customMessage then
        if currentGoldNum and previousGold then
            local goldGainedLastKill = math.max(0, currentGoldNum - previousGold)
            totalGoldGainedFromBosses = totalGoldGainedFromBosses + goldGainedLastKill
            previousGold = currentGoldNum
        end
        if currentGemsNum and previousGems then
            local gemsGainedLastKill = math.max(0, currentGemsNum - previousGems)
            totalGemsGainedFromBosses = totalGemsGainedFromBosses + gemsGainedLastKill
            previousGems = currentGemsNum
        end
    end

    local pingText = (config.bossRoleId and config.bossRoleId ~= "") and ("<@&" .. config.bossRoleId .. ">") or ""
    local messageContent = customMessage and "⚙️ **Webhook Connected**" or (pingText .. " ⚔️ **Boss Defeated!**")

    local embedData = {
        ["title"] = customMessage and "⚙️ Webhook Connected" or "⚔️ Boss Defeated!",
        ["color"] = customMessage and 3447003 or 65280,
        ["fields"] = {
            { ["name"] = "👤 Player", ["value"] = player.Name, ["inline"] = true },
            { ["name"] = "👹 Last Killed", ["value"] = customMessage or bossName, ["inline"] = true },
            { ["name"] = "💰 Total Gold Gained", ["value"] = customMessage and "N/A" or "+" .. tostring(totalGoldGainedFromBosses), ["inline"] = true },
            { ["name"] = "💎 Total Gems Gained", ["value"] = customMessage and "N/A" or "+" .. tostring(totalGemsGainedFromBosses), ["inline"] = true },
            { ["name"] = "🪙 Current Gold", ["value"] = currentGoldNum and tostring(currentGoldNum) or "N/A", ["inline"] = true },
            { ["name"] = "📊 Total Kills", ["value"] = tostring(totalKills), ["inline"] = true }
        },
        ["footer"] = { ["text"] = "Boss Kill Tracker • " .. get12HourTime() }
    }

    local requestBody = HttpService:JSONEncode({
        ["username"] = "Boss Kill Tracker",
        ["content"] = messageContent,
        ["embeds"] = { embedData }
    })

    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
    if httpRequest then
        httpRequest({
            Url = config.webhookUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = requestBody
        })
    end
end

